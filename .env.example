# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, NEVER exposed to the browser. Used for
# admin operations (product management, order status changes, inventory).
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay (payments) ──────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Secret key must never reach the client.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → the secret you set when adding the
# order.paid / payment.failed webhook pointing at /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Exposed to the client to open the Razorpay checkout widget (public, safe).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Jobert Apparels <orders@jobertapparels.com>"
ADMIN_NOTIFICATION_EMAIL=

# ── WhatsApp click-to-chat ───────────────────────────────────────────────
# E.164 format without the leading +, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
